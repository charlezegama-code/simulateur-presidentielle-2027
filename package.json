{
  "name": "simulateur-presidentielle-2027",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate-data": "tsx scripts/validate-data.ts data",
    "validate-fixtures": "tsx scripts/validate-data.ts tests/fixtures/valid --fixtures",
    "prebuild": "npm run validate-data && tsx scripts/copy-data.ts",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "preview": "vite preview",
    "predev": "tsx scripts/copy-data.ts",
    "check-bundle": "tsx scripts/check-bundle.ts",
    "postbuild": "npm run check-bundle"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "wouter": "^3.11.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "license": "MIT"
}
